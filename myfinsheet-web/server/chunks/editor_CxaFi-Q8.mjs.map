---
import FileEditor from "@rushike/svelte-components/FileEditor.svelte"
import AppLayout from "../layouts/AppLayout.astro"
// Read query parameter
const filePath = Astro.url.searchParams.get("file") 
  ?? "/workspace/upload/document_type.json"; // fallback
---

<AppLayout>
  <FileEditor client:only filePath = {filePath}></FileEditor>
</AppLayout>