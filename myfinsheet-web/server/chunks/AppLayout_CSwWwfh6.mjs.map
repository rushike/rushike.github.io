---
const { pathname } = Astro.url;

function isActive(path : string) {
  // Exact match for home, startsWith for others
  return path === "/" ? pathname === "/" : pathname.startsWith(path);
}
---
<nav class="desktop-nav">
  <div class="nav-group left">
    <a href="/" class={isActive("/") ? "active" : ""}>Home</a>
    <a href="/remail" class={isActive("/remail") ? "active" : ""}>rEmail</a>
    <a href="/stmt" class={isActive("/stmt") ? "active" : ""}>Statements</a>
    <a href="/configuration" class={isActive("/configuration") ? "active" : ""}>Configuration</a>
    <a href="/secret-manager" class={isActive("/secret-manager") ? "active" : ""}>Secret Manager</a>
    <a href="/file-manager" class={isActive("/file-manager") ? "active" : ""}>File Manager</a>
    <a href="/schema-manager" class={isActive("/schema-manager") ? "active" : ""}>Schema Manager</a>
  </div>

  <div class="nav-group right">
    <a href="/admin" class={isActive("/admin") ? "active" : ""}>Admin</a>
  </div>
</nav>



<style>
  /* Root navigation container */
  .desktop-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f6f6f6; /* Native light grey */
    border-bottom: 2px solid #d1d1d1;
    padding: 3px 8px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    user-select: none;
    cursor: default;
    width: 100vw;
    position: fixed;
    top: 0;
    z-index: 100;
  }

  .nav-group {
    display: flex;
    gap: 2px;
    align-items: center;
    height: 100%;
  }

  /* Link Styling */
  .desktop-nav a {
    text-decoration: none;
    color: #444;
    font-size: 13px;
    padding: 1px 12px;
    border-radius: 5px;
    height: 24px;
    display: flex;
    align-items: center;
    transition: background 0.15s ease, color 0.15s ease;
  }

  /* Hover state: Subtle grey highlight */
  .desktop-nav a:hover {
    background-color: #e8e8e8;
    color: #000;
    border-radius: 0;
  }

  /* Active state: "Pressed" or Selected look */
  .desktop-nav a.active {
    background-color: #efefef;
    color: black;
    font-weight: 600;
    border-radius: 0;
  }

  /* Click state */
  .desktop-nav a:active {
    opacity: 0.8;
    border-radius: 0;
    background-color: #e8e8e8;
  }

  /* Right-side grouping (Admin) */
  .right {
    border-left: 1px solid #e0e0e0;
    padding-left: 8px;
  }
</style>