---
import '../styles/global.css';
import Navbar from "../components/Navbar.astro";
import { ModeWatcher } from "mode-watcher";
import TailwindSafelist from "../components/TailwindSafelist.astro";
// import Footer from "../components/Footer.html";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Myfinsheet</title>
		<script is:inline>
			window.Module = window.Module || {};
			window.Module.locateFile = function(path, prefix) {
				if (path.endsWith('.wasm')) return '/pdfium.wasm';
				return (prefix || '') + path;
			};
			window.Module.onRuntimeInitialized = function() {
				window.__pdfium = window.Module;
			};
		</script>
		<script is:inline src="/pdfium.js"></script>
	</head>
  <body class="h-screen w-screen overflow-hidden bg-background text-foreground">
		<TailwindSafelist />
		<ModeWatcher client:load />
    <header style="height: 4vh;">
			<Navbar />
    </header>
		<section> 
			<slot name="sidebar"></slot>	
		</section>
		
    <main style="height: 96vh;">
			<slot></slot>
    </main>

    <footer>
      <slot name="footer"></slot>
    </footer>
  </body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
